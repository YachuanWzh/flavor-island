{
  "description": "Relay local Codex status and approvals to Flavor Island.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/codex-hook.mjs\"",
            "commandWindows": "node %PLUGIN_ROOT%\\scripts\\codex-hook.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/codex-hook.mjs\"",
            "commandWindows": "node %PLUGIN_ROOT%\\scripts\\codex-hook.mjs",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/codex-hook.mjs\"",
            "commandWindows": "node %PLUGIN_ROOT%\\scripts\\codex-hook.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/codex-hook.mjs\"",
            "commandWindows": "node %PLUGIN_ROOT%\\scripts\\codex-hook.mjs",
